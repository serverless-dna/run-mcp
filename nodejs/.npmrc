# NPM configuration for MCP Node.js container
# Optimize for container builds and caching

# Security and performance
audit-level=moderate
fund=false
update-notifier=false

# Cache configuration for Docker layer caching
cache=/tmp/.npm
prefer-offline=true
progress=false

# Registry configuration
registry=https://registry.npmjs.org/

# Package installation preferences
package-lock=true
save-exact=true
engine-strict=true

# Logging
loglevel=warn